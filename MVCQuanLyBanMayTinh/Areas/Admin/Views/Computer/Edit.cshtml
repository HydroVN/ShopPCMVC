@model MVCQuanLyBanMayTinh.Models.Computer
@{
    ViewData["Title"] = "Chỉnh Sửa Thông Tin Sản Phẩm";
}
<div class="container mt-5 mb-5" style="max-width: 750px;">
    <div class="card p-4 border border-0 shadow-sm" style="border-radius:16px;">
        <h4 class="fw-bold text-dark mb-1">Chỉnh Sửa Thông Tin Máy Tính</h4>
        <p class="text-muted small mb-4">Thay đổi thông tin linh kiện thiết bị và lưu lại cơ sở dữ liệu.</p>
        <hr class="mb-4" />

        <form asp-area="Admin" asp-controller="Computer" asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Created_At" />

            <div class="mb-4">
                <label class="form-label fw-bold text-muted small">Mã máy tính định danh (Hệ thống cố định)</label>
                <input class="form-control bg-light text-muted font-monospace fw-semibold" value="#COMP-@Model.Id" readonly disabled style="border-radius: 8px;" />
            </div>

            <div class="mb-4">
                <label asp-for="Name" class="form-label fw-bold small text-dark">Tên máy tính sản phẩm</label>
                <input asp-for="Name" class="form-control form-control-lg" style="border-radius: 8px;" />
                <span asp-validation-for="Name" class="text-danger small fw-medium"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-4">
                    <label asp-for="Brand" class="form-label fw-bold small text-dark">Hãng sản xuất</label>
                    <input asp-for="Brand" class="form-control" style="border-radius: 8px;" />
                    <span asp-validation-for="Brand" class="text-danger small fw-medium"></span>
                </div>
                <div class="col-md-6 mb-4">
                    <label asp-for="Category_Id" class="form-label fw-bold small text-dark">Danh mục sản phẩm</label>
                    <select asp-for="Category_Id" class="form-select" asp-items="ViewBag.Category_Id" style="border-radius: 8px;"></select>
                    <span asp-validation-for="Category_Id" class="text-danger small fw-medium"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-4">
                    <label asp-for="Price" class="form-label fw-bold small text-dark">Giá bán lẻ (đ)</label>
                    <input asp-for="Price" type="number" step="0.01" class="form-control" style="border-radius: 8px;" />
                    <span asp-validation-for="Price" class="text-danger small fw-medium"></span>
                </div>
                <div class="col-md-6 mb-4">
                    <label asp-for="Quantity" class="form-label fw-bold small text-dark">Số lượng sản phẩm trong kho</label>
                    <input asp-for="Quantity" type="number" class="form-control" style="border-radius: 8px;" />
                    <span asp-validation-for="Quantity" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="Image" class="form-label fw-bold small text-dark">Đường dẫn tệp hình ảnh đại diện (Image URL)</label>
                <input asp-for="Image" class="form-control" id="ImageInputUrl" style="border-radius: 8px;" />
                <div class="mt-3 text-center bg-light p-2 rounded-3">
                    <img id="ImagePreview" src="@Model.Image" class="img-fluid rounded-3 @(string.IsNullOrEmpty(Model.Image) ? "d-none" : "")" style="max-height: 140px; object-fit: contain;" alt="Xem trước" />
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="Description" class="form-label fw-bold small text-dark">Thông số phần cứng cấu hình thiết bị</label>
                <textarea asp-for="Description" class="form-control font-monospace text-sm" rows="5"></textarea>
            </div>

            <div class="d-flex gap-2 justify-content-end mt-4">
                <a asp-area="Admin" asp-controller="Computer" asp-action="Index" class="btn btn-light border py-2 px-4" style="border-radius: 8px;">Quay lại</a>
                <button type="submit" class="btn btn-warning py-2 px-4 text-dark fw-medium" style="border-radius: 8px;">Cập nhật sản phẩm</button>
            </div>
        </form>
    </div>
</div>
    <script src="~/js/computer-admin.js"></script>

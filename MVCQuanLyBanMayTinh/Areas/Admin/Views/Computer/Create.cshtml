@model MVCQuanLyBanMayTinh.Models.Computer
@{
    ViewData["Title"] = "Thêm Máy Tính Mới";
}
<div class="container mt-5 mb-5" style="max-width: 750px;">
    <div class="card p-4 border border-0 shadow-sm" style="border-radius:16px;">
        <h4 class="fw-bold text-dark mb-1">Thêm Máy Tính Vào Kho</h4>
        <p class="text-muted small mb-4">Vui lòng điền cấu hình linh kiện chi tiết đầu vào của thiết bị.</p>
        <hr class="mb-4" />

        <form asp-area="Admin" asp-controller="Computer" asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-4">
                <label asp-for="Name" class="form-label fw-bold small text-dark">Tên máy tính sản phẩm</label>
                <input asp-for="Name" class="form-control form-control-lg bg-light-subtle" placeholder="Nhập tên máy tính..." style="border-radius: 8px;" />
                <span asp-validation-for="Name" class="text-danger small fw-medium"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-4">
                    <label asp-for="Brand" class="form-label fw-bold small text-dark">Hãng sản xuất</label>
                    <input asp-for="Brand" class="form-control" placeholder="Dell, Asus, HP, Apple..." style="border-radius: 8px;" />
                    <span asp-validation-for="Brand" class="text-danger small fw-medium"></span>
                </div>
                <div class="col-md-6 mb-4">
                    <label asp-for="Category_Id" class="form-label fw-bold small text-dark">Danh mục phân loại</label>
                    <select asp-for="Category_Id" class="form-select" asp-items="ViewBag.Category_Id" style="border-radius: 8px;">
                        <option value="">-- Lựa chọn nhóm danh mục --</option>
                    </select>
                    <span asp-validation-for="Category_Id" class="text-danger small fw-medium"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-4">
                    <label asp-for="Price" class="form-label fw-bold small text-dark">Giá bán niêm yết (đ)</label>
                    <input asp-for="Price" type="number" step="0.01" class="form-control" placeholder="Yêu cầu mức giá lớn hơn 0" style="border-radius: 8px;" />
                    <span asp-validation-for="Price" class="text-danger small fw-medium"></span>
                </div>
                <div class="col-md-6 mb-4">
                    <label asp-for="Quantity" class="form-label fw-bold small text-dark">Số lượng máy nhập kho</label>
                    <input asp-for="Quantity" type="number" class="form-control" placeholder="Yêu cầu số lượng không âm" style="border-radius: 8px;" />
                    <span asp-validation-for="Quantity" class="text-danger small fw-medium"></span>
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="Image" class="form-label fw-bold small text-dark">Đường dẫn tệp hình ảnh đại diện (Image URL)</label>
                <input asp-for="Image" class="form-control" id="ImageInputUrl" placeholder="Ví dụ: /images/asus.jpg..." style="border-radius: 8px;" />
                <div class="mt-3 text-center bg-light p-2 rounded-3">
                    <img id="ImagePreview" src="" class="img-fluid d-none rounded-3" style="max-height: 140px; object-fit: contain;" alt="Xem trước" />
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="Description" class="form-label fw-bold small text-dark">Thông số linh kiện chi tiết phần cứng</label>
                <textarea asp-for="Description" class="form-control font-monospace small" rows="5" placeholder="CPU: Intel Core i5...&#10;RAM: 8GB..."></textarea>
            </div>

            <div class="d-flex gap-2 justify-content-end mt-4">
                <a asp-area="Admin" asp-controller="Computer" asp-action="Index" class="btn btn-light border py-2 px-4" style="border-radius: 8px;">Hủy bỏ</a>
                <button type="submit" class="btn btn-primary py-2 px-4" style="border-radius: 8px;">Lưu trữ vào kho</button>
            </div>
        </form>
    </div>
</div>
    <script src="~/js/computer-admin.js"></script>

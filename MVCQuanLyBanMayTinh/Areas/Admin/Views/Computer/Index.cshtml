@model IEnumerable<MVCQuanLyBanMayTinh.Models.Computer>
@{
    ViewData["Title"] = "Quản Lý Kho";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold m-0 text-dark">Quản Lý Danh Mục Máy Tính</h2>
        <p class="text-muted m-0 small">Bảng theo dõi số lượng linh kiện phần cứng nhập kho của hệ thống cửa hàng.</p>
    </div>
    <a asp-area="Admin" asp-controller="Computer" asp-action="Create" class="btn btn-primary px-3 py-2" style="border-radius: 8px;">
        <i class="bi bi-plus-lg"></i> Thêm máy tính mới
    </a>
</div>

<div class="table-responsive admin-data-table-wrapper p-3 shadow-sm bg-white">
    <table class="table align-middle table-hover m-0">
        <thead class="table-light text-muted small">
            <tr>
                <th>Hình ảnh</th>
                <th>Mã máy</th>
                <th>Tên Máy Tính</th>
                <th>Hãng sản xuất</th>
                <th>Giá Bán</th>
                <th>Số Lượng</th>
                <th>Trạng Thái</th>
                <th class="text-end">Hành Động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <img src="@(string.IsNullOrEmpty(item.Image) ? "/images/default-computer.jpg" : item.Image)" class="admin-table-thumb border bg-light" />
                    </td>
                    <td class="text-muted small font-monospace">#COMP-@item.Id</td>
                    <td class="fw-bold text-dark computer-name-target">@item.Name</td>
                    <td><span class="badge bg-light text-dark border px-2 py-1">@item.Brand</span></td>
                    <td class="fw-semibold text-primary">@item.Price.ToString("N0") đ</td>
                    <td class="fw-medium">@item.Quantity chiếc</td>
                    <td>
                        <span class="@(item.Quantity > 0 ? "badge-tech-in" : "badge-tech-out")">@item.Status</span>
                    </td>
                    <td class="text-end">
                        <div class="d-flex gap-2 justify-content-end">
                            <a asp-area="Admin" asp-controller="Computer" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning py-1 px-3" style="border-radius: 6px;">Sửa</a>

                            <form asp-area="Admin" asp-controller="Computer" asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline delete-computer-form">
                                @Html.AntiForgeryToken()
                                <button type="button" class="btn btn-sm btn-outline-danger py-1 px-3 btn-trigger-delete">Xóa</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hệ Thống Admin</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/computer-style.css" />
</head>
<body>
    <div class="container-fluid p-0">
        <div class="row g-0">
            <aside class="col-md-2 admin-sidebar-panel">
                <h5 class="fw-bold mb-4 px-2 text-white"><i class="bi bi-laptop"></i> Tech Admin</h5>
                <nav class="nav flex-column">
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="admin-nav-link">
                        <i class="bi bi-shop me-2"></i> Xem Cửa Hàng
                    </a>
                    <a asp-area="Admin" asp-controller="Computer" asp-action="Index" class="admin-nav-link active">
                        <i class="bi bi-cpu me-2"></i> Quản Lý Máy Tính
                    </a>
                </nav>
            </aside>

            <main class="col-md-10 p-5" style="background-color: #f8fafc; min-height: 100vh;">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/computer-admin.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
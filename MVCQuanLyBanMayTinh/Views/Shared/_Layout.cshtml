<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TechStore</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/computer-style.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom mb-3">
            <div class="container py-2">
                <a class="navbar-brand fw-bold fs-4 text-primary" asp-area="" asp-controller="Home" asp-action="Index">TechStore</a>
                <div class="d-sm-inline-flex justify-content-between flex-grow-1 ms-3">
                    <ul class="navbar-nav gap-2">
                        <li class="nav-item"><a class="nav-link text-dark fw-medium" asp-area="" asp-controller="Home" asp-action="Index">Cửa Hàng Máy Tính</a></li>
                    </ul>
                </div>
                <div class="d-flex align-items-center gap-3">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <span class="text-muted small">Xin chào, <strong class="text-success">@User.Claims.FirstOrDefault(c => c.Type == "FullName")?.Value</strong></span>
                        
                        // SỬA ĐIỀU HƯỚNG NAVBAR CLIENT: Gán thuộc tính asp-area="Admin" để khi click sẽ nhảy đúng vào vùng quản trị
                        if (User.IsInRole("1"))
                        {
                            <a asp-area="Admin" asp-controller="Computer" asp-action="Index" class="btn btn-dark btn-sm px-3 py-2">Vào Trang Admin</a>
                        }
                        <a asp-area="" asp-controller="Account" asp-action="Logout" class="btn btn-outline-danger btn-sm">Đăng xuất</a>
                    }
                    else
                    {
                        <a asp-area="" asp-controller="Account" asp-action="Login" class="btn btn-outline-primary btn-sm px-3">Đăng nhập</a>
                        <a asp-area="" asp-controller="Account" asp-action="Register" class="btn btn-primary btn-sm">Đăng ký</a>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid p-0">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
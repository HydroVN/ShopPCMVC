@model MVCQuanLyBanMayTinh.Models.User
@{
    ViewData["Title"] = "Đăng Ký Tài Khoản";
}
<link rel="stylesheet" href="~/css/computer-style.css" />

<div class="container">
    <div class="form-auth-wrapper bg-white">
        <h4 class="fw-bold text-center mb-4 text-dark">ĐĂNG KÝ THÀNH VIÊN</h4>
        
        <form asp-action="Register" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="mb-3">
                <label asp-for="Username" class="form-label small fw-bold">Tên đăng nhập mới</label>
                <input asp-for="Username" class="form-control py-2" placeholder="Ví dụ: tech_user" />
                <span asp-validation-for="Username" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="FullName" class="form-label small fw-bold">Họ và tên đầy đủ</label>
                <input asp-for="FullName" class="form-control py-2" placeholder="Ví dụ: Nguyễn Văn A" />
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label small fw-bold">Mật khẩu</label>
                <input asp-for="Password" type="password" class="form-control py-2" placeholder="Tối thiểu 6 ký tự..." />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-success w-100 py-2 mt-2">Đăng ký tài khoản</button>
        </form>
        <div class="text-center mt-4 small">
            <span class="text-muted">Đã có tài khoản?</span> 
            <a href="@Url.Action("Login", "Account")" class="fw-bold text-decoration-none">Đăng nhập ngay</a>
        </div>
    </div>
</div>